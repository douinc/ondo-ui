{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && bun run artifacts:build && bun run registry:build && next build && bun run export:finalize && bun run export:verify",
    "start": "next start",
    "test": "bun test",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release:version": "bun run scripts/release-version.ts",
    "release:publish": "changeset publish",
    "artifacts:build": "bun run scripts/generate-static-artifacts.ts",
    "export:finalize": "bun run scripts/finalize-static-export.ts",
    "export:verify": "bun run scripts/verify-static-export.ts",
    "registry:build": "shadcn build",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
    "@base-ui/react": "^1.8.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@shadcn/helpers": "^0.2.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.48.0",
    "ai": "^7.0.127",
    "chrono-node": "^2.10.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.16.1",
    "fumadocs-mdx": "^15.4.6",
    "input-otp": "^1.5.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.10.1",
    "rehype-pretty-code": "^0.14.5",
    "shadcn": "^4.21.1",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "zbsearch": "4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
