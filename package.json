{
  "name": "ondo-ui",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "bun run artifacts:build && bun run registry:build && next build && bun run export:finalize && bun run export:verify",
    "start": "next start",
    "test": "bun test",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "artifacts:build": "bun run scripts/generate-static-artifacts.ts",
    "export:finalize": "bun run scripts/finalize-static-export.ts",
    "export:verify": "bun run scripts/verify-static-export.ts",
    "registry:build": "shadcn build",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@base-ui/react": "^1.6.0",
    "@fontsource/monaspace-neon": "^5.2.5",
    "@fontsource/pretendard": "^5.2.5",
    "@number-flow/react": "^0.6.2",
    "@orama/orama": "3.1.18",
    "@shadcn/helpers": "^0.1.0",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.44.0",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.11.1",
    "fumadocs-mdx": "^15.1.0",
    "input-otp": "^1.4.2",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.8.0",
    "rehype-pretty-code": "^0.14.1",
    "shadcn": "^4.13.0",
    "shiki": "^3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
